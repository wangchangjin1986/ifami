# ifami Phase 0 环境变量
# 本机部署由 systemd EnvironmentFile 读取，只支持 KEY=value、注释独占一行（# 起头）。

API_ADDR=127.0.0.1:8080

# 微信
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
WX_HTTP_TIMEOUT_SECONDS=5
WX_OFFIACCOUNT_APPID=
WX_OFFIACCOUNT_SECRET=

# MySQL（本机 127.0.0.1:3306）
# RDS_DSN 必须加双引号：deploy.sh / backup.sh 用 source 读本文件，括号会被 bash 当语法解析
# MYSQL_ROOT_PASSWORD 留空 = root 本机免密（backup.sh 走 socket 免密）；仅备份脚本使用
MYSQL_ROOT_PASSWORD=
RDS_DSN="ifami:CHANGE_ME@tcp(127.0.0.1:3306)/ifami?parseTime=true"
# 数据库连接池（api/worker 进程各自生效）
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300
# SQL 日志：默认只打错误与慢 SQL；需要全量 SQL 时设为 debug
SQL_LOG_LEVEL=
SLOW_SQL_MS=200

# 火山引擎（TOS / SMS / 方舟，Phase 0 可选）
TOS_AK=
TOS_SK=
TOS_BUCKET_MEDIA=ifami-media
TOS_ENDPOINT=
SMS_AK=
SMS_SK=
SMS_SIGN=
# 火山方舟（拍照导入日程，豆包多模态）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 方舟推理接入点 ID（ep-xxxx）
ARK_MODEL=

# 拍照导入识别原图临时目录（落盘识别、任务结束即删；权限 700，属主为 api/worker 运行用户）
INGEST_DIR=/var/lib/ifami/ingest

# Redis（本机）
REDIS_ADDR=127.0.0.1:6379

# Worker 单轮触达到期任务批大小，避免积压时一次拉取过多
NOTIFY_DUE_JOB_BATCH_SIZE=200

# 字段级加密密钥（AES-256-GCM，生成：openssl rand -base64 32）
FIELD_ENC_KEY=

# 邀请 token 签名密钥（生成：openssl rand -hex 32）
INVITE_SECRET=

# golang-migrate 迁移文件目录
MIGRATIONS_DIR=/opt/ifami/migrations
