# ifami Phase 0 环境变量
# 本机部署由 systemd EnvironmentFile 读取，只支持 KEY=value、注释独占一行（# 起头）。

API_ADDR=127.0.0.1:8080

# 微信
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
WX_OFFIACCOUNT_APPID=
WX_OFFIACCOUNT_SECRET=

# MySQL（本机 127.0.0.1:3306）
MYSQL_ROOT_PASSWORD=
RDS_DSN=ifami:CHANGE_ME@tcp(127.0.0.1:3306)/ifami?parseTime=true

# 火山引擎（TOS / SMS / 方舟，Phase 0 可选）
TOS_AK=
TOS_SK=
TOS_BUCKET_MEDIA=ifami-media
TOS_ENDPOINT=
SMS_AK=
SMS_SK=
SMS_SIGN=
ARK_API_KEY=

# Redis（本机）
REDIS_ADDR=127.0.0.1:6379

# 字段级加密密钥（AES-256-GCM，生成：openssl rand -base64 32）
FIELD_ENC_KEY=

# 邀请 token 签名密钥（生成：openssl rand -hex 32）
INVITE_SECRET=

# golang-migrate 迁移文件目录
MIGRATIONS_DIR=/opt/ifami/migrations