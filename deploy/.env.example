# ifami Phase 0 环境变量
# 本机部署由 systemd EnvironmentFile 读取，只支持 KEY=value、注释独占一行（# 起头）。

API_ADDR=127.0.0.1:8080

# 微信
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
WX_HTTP_TIMEOUT_SECONDS=5
WX_OFFIACCOUNT_APPID=
WX_OFFIACCOUNT_SECRET=

# 微信小程序订阅消息通道
# mock = 只写日志不真实发送；wechat_subscribe = 调微信 subscribe.send 真实发送
NOTIFY_CHANNEL=wechat_subscribe
# 以下三个值填写微信公众平台「小程序 → 功能 → 订阅消息」里申请到的一次性订阅模板 ID。
# 示例 ID 形态：xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx，以下 WX_SUBSCRIBE_xxx 只是占位，请勿原样用于生产。
WX_SUBSCRIBE_TEMPLATE_SCHEDULE=WX_SUBSCRIBE_SCHEDULE_TEMPLATE_ID
WX_SUBSCRIBE_TEMPLATE_TASK=WX_SUBSCRIBE_TASK_TEMPLATE_ID
WX_SUBSCRIBE_TEMPLATE_FEEDBACK=WX_SUBSCRIBE_FEEDBACK_TEMPLATE_ID
# 模板内容样例 1：日程/接送提醒（对应 WX_SUBSCRIBE_TEMPLATE_SCHEDULE）
# 标题：日程提醒
# 字段：thing1=事项名称，time2=开始时间，thing3=地点或备注
# 示例：事项名称=接送小宝放学；开始时间=18:00；地点或备注=学校北门
# 模板内容样例 2：打卡任务提醒（对应 WX_SUBSCRIBE_TEMPLATE_TASK）
# 标题：打卡提醒
# 字段：thing1=任务名称，time2=提醒时间，thing3=提醒说明
# 示例：任务名称=阅读 20 分钟；提醒时间=20:00；提醒说明=点击去打卡
# 模板内容样例 3：反馈/备份提醒（对应 WX_SUBSCRIBE_TEMPLATE_FEEDBACK）
# 标题：家庭协作提醒
# 字段：thing1=提醒事项，time2=相关时间，thing3=原因或处理说明
# 示例：提醒事项=备份提醒：接送小宝放学；相关时间=18:00；原因或处理说明=原责任人未确认，请协助处理

# MySQL（本机 127.0.0.1:3306）
# RDS_DSN 必须加双引号：deploy.sh / backup.sh 用 source 读本文件，括号会被 bash 当语法解析
# MYSQL_ROOT_PASSWORD 留空 = root 本机免密（backup.sh 走 socket 免密）；仅备份脚本使用
MYSQL_ROOT_PASSWORD=
RDS_DSN="ifami:CHANGE_ME@tcp(127.0.0.1:3306)/ifami?parseTime=true"
# 数据库连接池（api/worker 进程各自生效）
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=1800
DB_CONN_MAX_IDLE_SECONDS=300
# SQL 日志：默认只打错误与慢 SQL；需要全量 SQL 时设为 debug
SQL_LOG_LEVEL=
SLOW_SQL_MS=200

# 火山引擎（TOS / SMS / 方舟，Phase 0 可选）
TOS_AK=
TOS_SK=
TOS_BUCKET_MEDIA=ifami-media
TOS_ENDPOINT=
SMS_AK=
SMS_SK=
SMS_SIGN=
# 火山方舟（拍照导入日程，豆包多模态）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 方舟推理接入点 ID（ep-xxxx）
ARK_MODEL=

# 拍照导入识别原图临时目录（落盘识别、任务结束即删；权限 700，属主为 api/worker 运行用户）
INGEST_DIR=/var/lib/ifami/ingest

# Redis（本机）
REDIS_ADDR=127.0.0.1:6379

# Worker 单轮触达到期任务批大小，避免积压时一次拉取过多
NOTIFY_DUE_JOB_BATCH_SIZE=200

# 字段级加密密钥（AES-256-GCM，生成：openssl rand -base64 32）
FIELD_ENC_KEY=

# 邀请 token 签名密钥（生成：openssl rand -hex 32）
INVITE_SECRET=
# 家庭加入码固定24小时；以下仅保护preview/confirm的失败输入，不限制家庭人数或换码。
JOIN_FAILED_USER_LIMIT=10
JOIN_FAILED_IP_LIMIT=30
JOIN_FAILED_WINDOW_SECONDS=900

# golang-migrate 迁移文件目录
MIGRATIONS_DIR=/opt/ifami/migrations
