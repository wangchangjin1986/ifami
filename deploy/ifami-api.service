[Unit]
Description=ifami API (Hertz)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ifami
EnvironmentFile=/opt/ifami/deploy/.env
ExecStart=/opt/ifami/ifami serve api
Restart=always
RestartSec=3
StandardOutput=append:/var/log/ifami-api.log
StandardError=append:/var/log/ifami-api.log

[Install]
WantedBy=multi-user.target