[Unit]
Description=ifami Worker（触达/提醒扫描）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ifami
EnvironmentFile=/opt/ifami/deploy/.env
ExecStart=/opt/ifami/ifami serve worker
Restart=always
RestartSec=3
StandardOutput=append:/var/log/ifami-worker.log
StandardError=append:/var/log/ifami-worker.log

[Install]
WantedBy=multi-user.target