<view class="page">
  <view class="app-head">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">加入「{{familyName}}」</text>
  </view>

  <view class="body">
    <view class="muted">{{desc}}</view>
    <view wx:if="{{isAdminInvite}}" class="banner"><text class="bt">管理员邀请</text><text>加入后可录入和编辑日程、管理成员。</text></view>

    <view class="card">
      <view class="ev-title">第 1 步 · 微信授权</view>
      <view class="ev-meta">✅ 已完成</view>
    </view>
    <view class="card">
      <view class="ev-title">第 2 步 · 提醒通道</view>
      <view class="ev-meta">可在设置中补充手机号；服务号提醒后续开放</view>
    </view>
    <view class="card">
      <view class="ev-title">第 3 步 · {{relationTitle}}</view>
      <view class="filters" style="margin-top:12rpx">
        <view class="chip {{relationIndex === i ? 'on' : ''}}" wx:for="{{relations}}" wx:for-index="i" wx:key="*this" bindtap="selectRelation" data-i="{{i}}">{{item}}</view>
      </view>
    </view>
    <button class="btn" bindtap="join" disabled="{{joining}}">完成，进入家庭</button>
  </view>
</view>
