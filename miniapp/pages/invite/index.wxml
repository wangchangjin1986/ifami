<view class="page">
  <view class="app-head">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">加入「{{familyName}}」</text>
  </view>

  <view class="body">
    <view class="muted">妈妈 邀请你加入家庭协作。整个过程不到 30 秒，不需要下载 App。</view>

    <view class="card">
      <view class="ev-title">第 1 步 · 微信授权</view>
      <view class="ev-meta">✅ 已完成</view>
    </view>
    <view class="card">
      <view class="ev-title">第 2 步 · 手机号</view>
      <view class="ev-meta">✅ 微信一键取号（用于重要提醒的短信兜底）</view>
    </view>
    <view class="card">
      <view class="ev-title">第 3 步 · 你是孩子的？</view>
      <view class="filters" style="margin-top:12rpx">
        <view class="chip {{relationIndex === i ? 'on' : ''}}" wx:for="{{relations}}" wx:for-index="i" wx:key="*this" bindtap="selectRelation" data-i="{{i}}">{{item}}</view>
      </view>
    </view>
    <view class="card">
      <view class="ev-title">第 4 步 · 关注服务号</view>
      <view class="ev-meta">接送提醒会发到这里，不漏消息</view>
    </view>

    <button class="btn" bindtap="join" disabled="{{joining}}">完成，进入家庭</button>
  </view>
</view>
