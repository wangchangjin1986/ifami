<view class="page {{largeText ? 'large-text' : ''}}">
  <view class="app-head">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">设置</text>
    <text wx:if="{{familyName}}" class="sub">{{familyName}}</text>
  </view>

  <view class="body">
    <view wx:if="{{!logged}}" class="empty">请先到「家庭」页登录</view>
    <view wx:elif="{{!hasFamily}}" class="empty">请先在「家庭」页创建家庭</view>

    <block wx:else>
      <view class="group-label">触达通道</view>
      <view class="card">
        <view class="rowline"><text>微信服务号</text><text class="v">{{serviceAccountStatus}}</text></view>
        <view class="rowline"><text>短信兜底</text><view class="toggle {{smsFallback ? 'on' : ''}}" bindtap="toggleSmsFallback"></view></view>
        <view class="rowline"><text>App 推送</text><text class="v">未安装 App（V2）</text></view>
      </view>

      <view class="group-label">提醒</view>
      <view class="card">
        <view class="rowline">
          <text>免打扰时段</text>
          <view class="time-range">
            <picker mode="time" value="{{dndStart}}" bindchange="onDndStart"><text class="v accent">{{dndStart}}</text></picker>
            <text class="v">–</text>
            <picker mode="time" value="{{dndEnd}}" bindchange="onDndEnd"><text class="v accent">{{dndEnd}}</text></picker>
          </view>
        </view>
        <view class="rowline"><text>免打扰期间仅强触达</text><view class="toggle {{strongOnlyInDnd ? 'on' : ''}}" bindtap="toggleStrongOnly"></view></view>
      </view>

      <view class="group-label">通用</view>
      <view class="card">
        <view class="rowline"><text>大字模式</text><view class="toggle {{largeText ? 'on' : ''}}" bindtap="toggleLargeText"></view></view>
        <view class="rowline"><text>语言</text><text class="v">简体中文</text></view>
      </view>

      <view class="group-label">数据与隐私</view>
      <view class="card">
        <view class="rowline tappable" bindtap="exportChildData"><text>导出孩子数据</text><text class="v accent">申请导出</text></view>
        <view class="rowline tappable" bindtap="deleteChildProfile"><text>删除孩子档案</text><text class="v danger">需管理员确认</text></view>
      </view>

      <view class="note">设置会先保存在当前设备；真实服务号、短信和批量导出通道接入后，将同步为家庭级配置。</view>
    </block>
  </view>
</view>
