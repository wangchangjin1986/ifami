<view class="page">
  <view class="app-head">
    <text class="back" bindtap="goBack">‹ 返回</text>
    <text class="title">{{done ? '打卡' : title}}</text>
  </view>

  <view class="body" wx:if="{{!done}}">
    <view class="field">
      <text class="label">为谁打卡？</text>
      <view class="who"><button class="on">{{childName}}</button></view>
    </view>

    <view class="field">
      <text class="label">打卡方式</text>
      <view class="methods">
        <button class="{{methodIndex === mi ? 'on' : ''}}" wx:for="{{methods}}" wx:for-index="mi" wx:key="key" bindtap="selectMethod" data-i="{{mi}}">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{methods[methodIndex].key !== 'photo'}}" class="field">
      <text class="label">本次{{goalUnit}}数</text>
      <input class="input" type="number" placeholder="{{goalUnit === '个' ? '本次数量' : '本次分钟数'}}" value="{{amount}}" bindinput="onAmount" />
    </view>

    <view class="muted">孩子没有账号，在父母设备上切换身份提交；也可由家长代打。</view>
    <button class="btn" bindtap="submit" disabled="{{submitting}}">完成打卡</button>
  </view>

  <view class="body" wx:else>
    <view class="done-hero">
      <view class="ok">✅</view>
      <view class="t">{{title}} 已完成</view>
      <view class="s">⏱ {{methods[methodIndex].label}} · 📅 连续 {{streakDays}} 天</view>
    </view>
    <button class="btn" bindtap="more">再打一个</button>
    <button class="btn ghost" bindtap="finish">完成</button>
    <view class="note">“连续 {{streakDays}} 天”是事实记录，不是积分奖励（激励体系后置）</view>
  </view>
</view>
