<view class="page">
  <block wx:if="{{!logged}}">
    <view class="empty">请先到「家庭」页登录</view>
  </block>

  <block wx:elif="{{!hasFamily}}">
    <view class="empty">请先在「家庭」页创建家庭并添加孩子</view>
  </block>

  <block wx:else>
    <view class="app-head">
      <text class="title">今天</text>
      <text class="sub">{{dateStr}} · {{familyName}}</text>
    </view>

    <view class="body">
      <view wx:if="{{hasReddot}}" class="banner">
        <view class="bt">有 {{notifyReddots.length}} 条待确认提醒</view>
        <view class="muted">点击查看详情后会自动回执，停止继续升级备份联系人。</view>
        <view class="rowline" wx:for="{{notifyReddots}}" wx:key="job_id" bindtap="tapReddot" data-id="{{item.job_id}}">
          <view class="row-main">
            <view>{{item.payload.title || item.payload.task || '家庭提醒'}}</view>
            <view class="ev-meta">{{item.payload.time_text || item.payload.reason || '请及时查看'}}</view>
          </view>
          <text class="v">查看</text>
        </view>
      </view>

      <view wx:if="{{empty}}" class="empty">今天暂无日程</view>

      <view class="card tappable" wx:for="{{items}}" wx:key="instanceId" bindtap="tapItem" data-id="{{item.instanceId}}">
        <view class="ev">
          <text class="ev-time">{{item.start}}</text>
          <view class="ev-main">
            <view class="ev-title">{{item.title}} <text wx:if="{{item.owner}}" class="chip">{{item.owner}}</text></view>
            <text class="ev-meta">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </view>

    <button wx:if="{{isAdmin}}" class="fab" bindtap="openFab">＋</button>
    <view class="sheet-mask" wx:if="{{sheetOpen}}" bindtap="closeFab">
      <view class="sheet" catchtap="noop">
        <button class="opt" bindtap="goEvent"><text class="opt-b">安排一件事</text><text class="opt-s">课程、接送、活动——有固定时间和地点，进日历</text></button>
        <button class="opt" bindtap="goTask"><text class="opt-b">创建打卡任务</text><text class="opt-s">阅读、跳绳——重复的目标行为，进打卡</text></button>
        <button class="opt" bindtap="goImport"><text class="opt-b">📷 拍照导入日程</text><text class="opt-s">拍课表、作息表、群通知截图——自动识别成日程草稿，确认后入库</text></button>
        <button class="btn ghost" bindtap="closeFab">取消</button>
      </view>
    </view>
  </block>
</view>
