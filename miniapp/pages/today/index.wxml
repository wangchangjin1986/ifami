<view class="page">
  <block wx:if="{{!logged}}">
    <view class="empty">请先到「家庭」页登录</view>
  </block>

  <block wx:elif="{{!hasFamily}}">
    <view class="empty">请先在「家庭」页创建家庭并添加孩子</view>
  </block>

  <block wx:else>
    <view class="app-head">
      <text class="title">今天</text>
      <text class="sub link">{{dateStr}} · {{familyName}} ▾</text>
    </view>

    <view class="body">
      <view wx:if="{{empty}}" class="empty">今天暂无日程</view>

      <view class="card tappable" wx:for="{{items}}" wx:key="instanceId" bindtap="tapItem" data-id="{{item.instanceId}}">
        <view class="ev">
          <text class="ev-time">{{item.start}}</text>
          <view class="ev-main">
            <view class="ev-title">{{item.title}} <text wx:if="{{item.owner}}" class="chip">{{item.owner}}</text></view>
            <text class="ev-meta">{{item.meta}}</text>
          </view>
        </view>
      </view>
    </view>

    <button class="fab" bindtap="openFab">＋</button>
    <view class="sheet-mask" wx:if="{{sheetOpen}}" bindtap="closeFab">
      <view class="sheet" catchtap="noop">
        <button class="opt" bindtap="goEvent"><text class="opt-b">安排一件事</text><text class="opt-s">课程、接送、活动——有固定时间和地点，进日历</text></button>
        <button class="opt" bindtap="goTask"><text class="opt-b">创建打卡任务</text><text class="opt-s">阅读、跳绳——重复的目标行为，进打卡</text></button>
        <button class="btn ghost" bindtap="closeFab">取消</button>
      </view>
    </view>
  </block>
</view>
