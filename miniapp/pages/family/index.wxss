.hero { padding: 240rpx 0; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.hero-title { font-size: 96rpx; font-weight: 700; color: var(--accent); }
.hero-sub { color: var(--muted); font-size: 28rpx; }

.input { border: 2rpx solid var(--line); border-radius: 20rpx; padding: 22rpx 24rpx; font-size: 30rpx; background: var(--surface); width: 100%; box-sizing: border-box; margin-bottom: 16rpx; }

.row-btn { flex: 1; }

.invite-row { display: flex; align-items: center; gap: 16rpx; }
.invite-token { flex: 1; font-size: 22rpx; color: var(--muted); word-break: break-all; }
.invite-copy { color: var(--accent); font-size: 26rpx; }
