<view class="page">
  <block wx:if="{{!logged}}">
    <view class="empty">请先到「家庭」页登录</view>
  </block>

  <block wx:elif="{{!hasFamily}}">
    <view class="empty">请先在「家庭」页创建家庭并添加孩子</view>
  </block>

  <block wx:else>
    <view class="app-head">
      <text class="title">打卡</text>
      <text class="sub">今日任务</text>
    </view>

    <view class="body">
      <view wx:if="{{isAdmin}}" class="card tappable" bindtap="goTaskTemplates">
        <view class="rowline"><text>任务模板</text><text class="v">阅读 / 跳绳 / 练琴</text></view>
        <view class="muted">一次勾选多个常见任务，统一设置孩子、频次和责任家长。</view>
      </view>
      <view wx:if="{{loading}}" class="empty">正在加载今日任务…</view>
      <view wx:elif="{{groups.length === 0}}" class="empty">暂无打卡任务，点右下角 ＋ 新建</view>

      <block wx:else>
        <block wx:for="{{groups}}" wx:for-item="g" wx:key="childId">
          <view class="group-label">{{g.childName}}</view>
          <view
            class="card task {{t.today_checked ? 'done' : ''}}"
            wx:for="{{g.tasks}}"
            wx:for-item="t"
            wx:key="task_id"
            bindtap="tapTask"
            data-task="{{t}}"
          >
            <view class="dot">{{t.today_checked ? '✓' : ''}}</view>
            <view class="ev-main">
              <view class="ev-title">{{t.title}}</view>
              <view class="ev-meta">{{t.meta}}</view>
            </view>
            <text wx:if="{{!t.today_checked}}" class="chip gray">去打卡</text>
          </view>
        </block>
      </block>
    </view>

    <button wx:if="{{isAdmin}}" class="fab" bindtap="openFab">＋</button>
    <view class="sheet-mask" wx:if="{{sheetOpen}}" bindtap="closeFab">
      <view class="sheet" catchtap="noop">
        <button class="opt" bindtap="goEvent"><text class="opt-b">安排一件事</text><text class="opt-s">课程、接送、活动——有固定时间和地点，进日历</text></button>
        <button class="opt" bindtap="goTask"><text class="opt-b">创建打卡任务</text><text class="opt-s">阅读、跳绳——重复的目标行为，进打卡</text></button>
        <button class="opt" bindtap="goImport"><text class="opt-b">📷 拍照导入日程</text><text class="opt-s">拍课表、作息表、群通知截图——自动识别成日程草稿，确认后入库</text></button>
        <button class="btn ghost" bindtap="closeFab">取消</button>
      </view>
    </view>
  </block>
</view>
